# Set these through the hosting environment. This project does not auto-load .env files.
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# Set false only when HTTPS redirect is safely handled by the hosting platform.
DJANGO_SECURE_SSL_REDIRECT=True
